{
  "name": "docbd-info",
  "private": true,
  "version": "0.27.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "pwa:validate": "node scripts/validate-pwa.mjs && node --experimental-strip-types scripts/validate-pwa-install-promotion.mjs && node scripts/validate-push-notifications.mjs",
    "push:keys": "node scripts/generate-vapid.mjs",
    "push:validate": "node scripts/validate-push-notifications.mjs",
    "slugshare:validate": "node --experimental-strip-types scripts/validate-public-slugs-sharing.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.6.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
