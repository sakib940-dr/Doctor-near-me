VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# New Supabase projects use a publishable key. The legacy anon key is also supported.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY


# Public VAPID key only. Safe for the browser bundle.
# Generate a matching public/private pair with: npm run push:keys
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
